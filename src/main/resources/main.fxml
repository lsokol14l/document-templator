<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="by.michael.MainController" style="-fx-font-size: 12;">
    <top>
        <VBox style="-fx-padding: 15; -fx-spacing: 10; -fx-background-color: #f0f0f0;">
            <Label text="Генератор писем в формате DOCX" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="15" style="-fx-padding: 20;">
                <!-- Выбор шаблона -->
                <HBox spacing="10">
                    <Label text="Путь к шаблону:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="templatePathField" editable="false" HBox.hgrow="ALWAYS"/>
                    <Button text="Выбрать" onAction="#onChooseTemplate"/>
                </HBox>

                <!-- Дата и номер письма -->
                <Separator/>
                <Label text="Реквизиты письма" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                <HBox spacing="10">
                    <Label text="Дата письма:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="letterDateField" promptText="дд-мм-YYYY" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Номер письма:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="letterNumberField" promptText="Введите номер" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Данные адресата -->
                <Separator/>
                <Label text="Адресат" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                <HBox spacing="10">
                    <Label text="Должность:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="recipientPostField" promptText="Введите должность" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Организация:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="recipientOrganizationField" promptText="Введите организацию" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="ФИО:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="recipientNameField" promptText="Введите ФИО адресата" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Приветствие -->
                <HBox spacing="10">
                    <Label text="Приветствие:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="greetingField" promptText="Уважаемый (-ая)..." HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Содержание письма -->
                <Separator/>
                <Label text="Содержание письма" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                <Label text="Текст письма:"/>
                <TextArea fx:id="letterBodyArea" wrapText="true" prefRowCount="8" promptText="Введите текст письма..."/>

                <!-- Приложения -->
                <Label text="Список приложений:"/>
                <TextArea fx:id="appendixListArea" wrapText="true" prefRowCount="4"
                          promptText="Перечислите приложения..."/>

                <!-- Данные отправителя -->
                <Separator/>
                <Label text="Отправитель" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                <HBox spacing="10">
                    <Label text="Должность:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="senderPostField" promptText="Должность отправителя" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="ФИО:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="senderNameField" promptText="ФИО отправителя" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Данные исполнителя -->
                <Separator/>
                <Label text="Исполнитель" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

                <HBox spacing="10">
                    <Label text="ФИО:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="executorNameField" promptText="ФИО исполнителя" HBox.hgrow="ALWAYS"/>
                </HBox>

                <HBox spacing="10">
                    <Label text="Телефон:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="executorPhoneField" promptText="Телефон исполнителя" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Путь сохранения -->
                <Separator/>
                <HBox spacing="10">
                    <Label text="Сохранить как:" style="-fx-min-width: 120;"/>
                    <TextField fx:id="outputPathField" editable="false" HBox.hgrow="ALWAYS"/>
                    <Button text="Выбрать" onAction="#onChooseOutputPath"/>
                </HBox>

                <!-- Кнопки действий -->
                <Separator/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Создать документ" style="-fx-padding: 10; -fx-font-size: 13;"
                            onAction="#onGenerateDocument" prefWidth="200"/>
                    <Button text="Очистить" style="-fx-padding: 10;" onAction="#onClear"/>
                </HBox>

                <!-- Статус -->
                <Separator/>
                <Label fx:id="statusLabel" text="Статус: готово" style="-fx-text-fill: #0066cc;"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>